{
	"name": "orqeto-dev-vscode",
	"displayName": "Orqeto Dev",
	"description": "Integra o Explorer do VS Code com o Orqeto Dev.",
	"version": "2.0.0",
	"publisher": "orqeto",
	"engines": {
		"vscode": "^1.100.0"
	},
	"categories": [
		"Other"
	],
	"main": "./dist/extension.js",
	"activationEvents": [
		"onStartupFinished"
	],
	"contributes": {
		"commands": [
			{
				"command": "orqetoDev.sendToContext",
				"title": "Enviar para Orqeto Context",
				"enablement": "orqetoDev.projectOpen && orqetoDev.createContextMode && !orqetoDev.ignoreMode"
			},
			{
				"command": "orqetoDev.sendToContextAndCopy",
				"title": "Send and copy Orqeto Context",
				"enablement": "orqetoDev.projectOpen && orqetoDev.createContextMode && !orqetoDev.ignoreMode"
			},
			{
				"command": "orqetoDev.removeFromContext",
				"title": "Remove from Orqeto Context",
				"enablement": "orqetoDev.projectOpen && orqetoDev.createContextMode && !orqetoDev.ignoreMode"
			},
			{
				"command": "orqetoDev.sendToIgnore",
				"title": "Enviar para Orqeto Dev Ignore",
				"enablement": "orqetoDev.projectOpen && orqetoDev.ignoreMode"
			},
			{
				"command": "orqetoDev.removeFromIgnore",
				"title": "Remove from Orqeto Dev Ignore",
				"enablement": "orqetoDev.projectOpen && orqetoDev.ignoreMode"
			},
			{
				"command": "orqetoDev.openFolder",
				"title": "Open in Orqeto Dev"
			}
		],
		"menus": {
			"explorer/context": [
				{
					"command": "orqetoDev.sendToContext",
					"when": "orqetoDev.projectOpen && orqetoDev.createContextMode && !orqetoDev.ignoreMode && resourceScheme == file",
					"group": "orqeto@1"
				},
				{
					"command": "orqetoDev.sendToContextAndCopy",
					"when": "orqetoDev.projectOpen && orqetoDev.createContextMode && !orqetoDev.ignoreMode && resourceScheme == file",
					"group": "orqeto@2"
				},
				{
					"command": "orqetoDev.removeFromContext",
					"when": "orqetoDev.projectOpen && orqetoDev.createContextMode && !orqetoDev.ignoreMode && resourceScheme == file",
					"group": "orqeto@3"
				},
				{
					"command": "orqetoDev.sendToIgnore",
					"when": "orqetoDev.projectOpen && orqetoDev.ignoreMode && resourceScheme == file",
					"group": "orqeto@1"
				},
				{
					"command": "orqetoDev.removeFromIgnore",
					"when": "orqetoDev.projectOpen && orqetoDev.ignoreMode && resourceScheme == file",
					"group": "orqeto@2"
				},
				{
					"command": "orqetoDev.openFolder",
					"when": "resourceScheme == file && explorerResourceIsFolder && (orqetoDev.allowOpenSubfolders || resourcePath in orqetoDev.openProjectRootPaths)",
					"group": "orqeto@4"
				}
			],
			"commandPalette": [
				{
					"command": "orqetoDev.sendToContext",
					"when": "orqetoDev.projectOpen && orqetoDev.createContextMode && !orqetoDev.ignoreMode"
				},
				{
					"command": "orqetoDev.sendToContextAndCopy",
					"when": "orqetoDev.projectOpen && orqetoDev.createContextMode && !orqetoDev.ignoreMode"
				},
				{
					"command": "orqetoDev.removeFromContext",
					"when": "orqetoDev.projectOpen && orqetoDev.createContextMode && !orqetoDev.ignoreMode"
				},
				{
					"command": "orqetoDev.sendToIgnore",
					"when": "orqetoDev.projectOpen && orqetoDev.ignoreMode"
				},
				{
					"command": "orqetoDev.removeFromIgnore",
					"when": "orqetoDev.projectOpen && orqetoDev.ignoreMode"
				},
				{
					"command": "orqetoDev.openFolder",
					"when": "orqetoDev.allowOpenSubfolders || orqetoDev.workspaceRootExactlyOpen"
				}
			]
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"package": "npm run build && vsce package --no-dependencies --allow-missing-repository --skip-license --out orqeto-dev-vscode.vsix",
		"typecheck": "tsc -p tsconfig.json --noEmit"
	},
	"devDependencies": {
		"@types/node": "^26.2.0",
		"@types/vscode": "1.100.0",
		"@vscode/vsce": "^3.9.2",
		"typescript": "~6.0.2"
	}
}
