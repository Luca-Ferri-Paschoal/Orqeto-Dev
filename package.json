{
	"name": "orqeto-dev",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"dev": "npm run version:check && npm run vscode:package && tauri dev",
		"dev:web": "vite",
		"build": "npm run version:check && npm run validate && npm run vscode:package && tauri build",
		"build:web": "tsc -b && vite build",
		"preview": "vite preview",
		"count:lines": "node scripts/count-lines.mts",
		"format:ts": "node scripts/format-typescript.mts write",
		"format:check": "node scripts/format-typescript.mts check",
		"lint": "eslint --config eslint.config.mts . --max-warnings 0",
		"lint:fix:eslint": "eslint --config eslint.config.mts . --fix",
		"lint:fix": "npm run lint:fix:eslint && npm run format:ts && npm run lint",
		"lint:batch": "node scripts/lint-batch.mts",
		"lint:batch:app": "node scripts/lint-batch.mts --scope app",
		"lint:batch:vscode": "node scripts/lint-batch.mts --scope vscode",
		"diagnostics:app": "node scripts/diagnostics-batch.mts --scope app",
		"diagnostics:vscode": "node scripts/diagnostics-batch.mts --scope vscode",
		"diagnostics:all": "node scripts/diagnostics-batch.mts --scope all",
		"typecheck": "npm run typecheck:app && npm run typecheck:vscode",
		"typecheck:app": "tsc -b",
		"typecheck:vscode": "tsc -p integrations/vscode/tsconfig.json --noEmit",
		"typecheck:batch": "node scripts/typecheck-batch.mts",
		"typecheck:batch:app": "node scripts/typecheck-batch.mts --scope app",
		"typecheck:batch:vscode": "node scripts/typecheck-batch.mts --scope vscode",
		"validate": "npm run typecheck && npm run format:check && npm run lint",
		"tauri": "tauri",
		"vscode:build": "npm --prefix integrations/vscode run build",
		"vscode:package": "npm --prefix integrations/vscode install && npm --prefix integrations/vscode run package",
		"vscode:install": "npm run vscode:package && code --install-extension integrations/vscode/orqeto-dev-vscode.vsix --force",
		"version:set": "tsx scripts/set-version.mts",
		"version:check": "tsx scripts/set-version.mts --check"
	},
	"dependencies": {
		"@tauri-apps/api": "2.11.1",
		"@tauri-apps/plugin-clipboard-manager": "2.3.2",
		"@tauri-apps/plugin-dialog": "2.7.2",
		"@tauri-apps/plugin-sql": "2.4.0",
		"clsx": "^2.1.1",
		"lucide-react": "^1.34.0",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"tailwind-merge": "^3.6.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@tailwindcss/vite": "^4.3.3",
		"@tauri-apps/cli": "2.11.4",
		"@types/node": "^26.2.0",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@types/vscode": "1.100.0",
		"@vitejs/plugin-react": "^6.0.5",
		"eslint": "^10.8.1",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.4",
		"eslint-plugin-simple-import-sort": "^14.0.0",
		"globals": "^17.11.0",
		"ignore": "^7.0.6",
		"jiti": "^2.7.0",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.0",
		"typescript": "~6.0.2",
		"typescript-eslint": "^8.67.0",
		"vite": "^8.1.0"
	},
	"engines": {
		"node": ">=22.12.0"
	}
}
